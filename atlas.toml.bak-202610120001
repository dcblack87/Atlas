# Local (MacBook) Atlas config — gitignored, never committed.
# Atlas here runs as a monitoring client over Tailscale; the permanent
# always-on install lives on ballcourt-prod.

[atlas]
db_path = "atlas.db"
display_profile = "standard"

[ssh]
key_file = "~/.ssh/id_ed25519"
user = "root"
connect_timeout = 10
keepalive = 30

[[hosts]]
name = "quotelab-prod"
address = "100.126.25.51"
apps = ["bookingmachine", "marketing", "dcblack"]

[[hosts]]
name = "directorylab-1"
address = "100.98.185.4"
apps = ["directorylab", "joblab", "launchlab", "labstore"]

[[hosts]]
name = "ballcourt-prod"
address = "100.81.79.24"
apps = ["aeo"]

# MobileDetailing.io — the client's own VPS (John's Hetzner account), cutover
# 25 Sep 2026 from directorylab-1.
[[hosts]]
name = "mobiledetailing-1"
address = "100.73.125.51"
apps = ["mobiledetailing"]

[apps.bookingmachine]
kind = "single-container"
path = "/opt/bookingmachine"
container = "bookingmachine"
liveness_url = "http://127.0.0.1:3000/"
deploy_command = "./scripts/deploy.sh update"
github_repo = "dcblack87/QuoteLab"

[apps.marketing]
kind = "compose"
path = "/opt/marketing-agent"
health_url = "http://127.0.0.1:3100/api/health"
deploy_command = "./scripts/deploy.sh update"
github_repo = "dcblack87/Marketing-Agent"

# dcblack.co.uk — David's personal brand site. A TENANT on quotelab-prod, which
# also runs BookingMachine: own container, own network, own Postgres
# (dcblack-db), own nginx vhost, own port. Bound to 127.0.0.1:3300 only.
#
# health_url rather than liveness_url: /api/health runs `select 1` against
# Postgres, so it distinguishes "the container is up" from "the app can
# actually serve a page". A container answering 200 on / while every request
# 500s on a dead pool is exactly what this should catch.
#
# Backups follow the <path>/backups convention (db dump + the uploads volume,
# daily 04:30 UTC — deliberately off BookingMachine's 03:00), so backups_path
# is left at its default.
[apps.dcblack]
kind = "single-container"
path = "/opt/dcblack"
container = "dcblack"
health_url = "http://127.0.0.1:3300/api/health"
deploy_command = "./scripts/deploy.sh update"
github_repo = "dcblack87/Personal-Brand-Website"

# The store at directorylab.io, from github.com/dcblack87/directorylab.
# NOT [apps.directorylab], which is the Local Lab sites on the same host.
[apps.labstore]
kind = "single-container"
path = "/opt/labstore"
container = "labstore"
health_url = "http://127.0.0.1:3400/api/health"
deploy_command = "./scripts/deploy.sh update"
github_repo = "dcblack87/directorylab"

[apps.directorylab]
kind = "multi-site"
path = "/opt/directorylab"
sites_dir = "/opt/directorylab/sites"
container_prefix = "directorylab-"
deploy_command = "./scripts/deploy.sh update"

# MobileDetailing.io - client platform for 500Knots Digital LLC.
# Runs on mobiledetailing-1, the client's own VPS, since 25 Sep 2026.
[apps.mobiledetailing]
kind = "compose"
path = "/opt/mobiledetailing"
deploy_command = "./scripts/deploy.sh update"
health_url = "http://127.0.0.1:5101/health"
github_repo = "500Knots-Digital/mobiledetailing"
backups_path = "/opt/mobiledetailing-backups"

[apps.joblab]
kind = "multi-site"
path = "/opt/joblab"
sites_dir = "/opt/joblab/sites"
container_prefix = "joblab-"
deploy_command = "./scripts/prod/deploy.sh update"
github_repo = "dcblack87/Job-Lab"

# Launch Lab - the three launch sites (BioLaunch, Agent Week, Apps For Stores) on one
# codebase, each a container behind host nginx. Added 6 Oct 2026, closed behind a
# coming-soon page until opened.
[apps.launchlab]
kind = "multi-site"
path = "/opt/launchlab"
sites_dir = "/opt/launchlab/sites"
container_prefix = "launchlab-"
deploy_command = "./scripts/deploy.sh update"
github_repo = "dcblack87/Agent-Week"

# MentionMachine (internal codename `aeo`) — replaced Ballcourt on this box,
# 16 Aug 2026. A TENANT: /opt/atlas, /opt/claude-telegram and /opt/offsite all
# live on the same host and its deploy script fingerprints them before and after
# every run, refusing to report success if any of them changed.
#
# health_url rather than liveness_url, for the same reason as dcblack: /api/health
# touches the database, so it separates "the container is up" from "the app can
# serve a page". It returns {"status":"ok"} — the only two values Atlas treats as
# healthy are "ok" and "healthy", so anything else here would read as degraded.
#
# Backups follow the <path>/backups convention (daily/weekly/monthly, encrypted
# .dump, 03:00 UTC) so backups_path is left at its default. The 04:30 offsite push
# is done by /opt/offsite/offsite-sync.sh, the fleet hub, which was moved out of
# /opt/ballcourt before that directory was retired.
[apps.aeo]
kind = "compose"
path = "/opt/aeo"
health_url = "http://127.0.0.1:3200/api/health"
deploy_command = "./scripts/deploy.sh update"
github_repo = "dcblack87/AI-SEO-SaaS"

[ai]
enabled = true
# key comes from $ANTHROPIC_API_KEY when you export it

[telegram]
enabled = false

[hcloud]
enabled = false

[deploy]
enabled = true
# 1800, not the default 900. A warm build is 2-3 minutes, but a cold one rebuilds
# the worker image, which carries Chromium, and lands close to 15 minutes. On
# timeout Atlas SIGTERMs only the top-level `sh`, so an orphaned `docker compose
# build` keeps running while the deploy is recorded as failed — worth avoiding.
timeout_seconds = 1800
remediations = [
    "docker restart {container}",
    "docker builder prune -f",
]

# Drift and CI status. There was no [github] block at all until now, which is why
# `drift.commits_behind` has never been written for any app — including the two
# that already carry `github_repo`. Inert until a token exists: the collector reads
# $ATLAS_GITHUB_TOKEN first, then `token` here. A read-only fine-grained PAT with
# Contents: read, Actions: read, Pull requests: read is all it needs.
#
# Note the collector hard-codes the `main` branch; every repo here uses it.
[github]
enabled = true
# token = "..."   # or export ATLAS_GITHUB_TOKEN
